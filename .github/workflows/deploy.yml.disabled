name: Deploy

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io

jobs:
  publish:
    name: Build and Publish Images
    runs-on: ubuntu-latest
    outputs:
      backend_image: ${{ steps.images.outputs.backend_image }}
      frontend_image: ${{ steps.images.outputs.frontend_image }}
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve image names
        id: images
        run: |
          repository="${GITHUB_REPOSITORY,,}"
          echo "backend_image=${REGISTRY}/${repository}/backend" >> "$GITHUB_OUTPUT"
          echo "frontend_image=${REGISTRY}/${repository}/frontend" >> "$GITHUB_OUTPUT"

      - name: Build and push backend
        uses: docker/build-push-action@v6
        with:
          context: ./variantor-be
          file: ./variantor-be/Dockerfile
          push: true
          tags: |
            ${{ steps.images.outputs.backend_image }}:${{ github.sha }}
            ${{ steps.images.outputs.backend_image }}:latest
          cache-from: type=gha,scope=backend
          cache-to: type=gha,mode=max,scope=backend

      - name: Build and push frontend
        uses: docker/build-push-action@v6
        with:
          context: ./variantor-fe
          file: ./variantor-fe/Dockerfile
          push: true
          tags: |
            ${{ steps.images.outputs.frontend_image }}:${{ github.sha }}
            ${{ steps.images.outputs.frontend_image }}:latest
          cache-from: type=gha,scope=frontend
          cache-to: type=gha,mode=max,scope=frontend

  deploy:
    name: Deploy over SSH
    runs-on: ubuntu-latest
    needs: publish
    environment: production
    env:
      DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
      DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
      DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
      DEPLOY_PORT: ${{ vars.DEPLOY_PORT }}
      DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
      APP_PORT: ${{ vars.APP_PORT }}
      APP_ENV: ${{ vars.APP_ENV }}
      CORS_ALLOWED_ORIGIN: ${{ vars.CORS_ALLOWED_ORIGIN }}
      POSTGRES_DB: ${{ vars.POSTGRES_DB }}
      POSTGRES_USER: ${{ vars.POSTGRES_USER }}
      POSTGRES_PASSWORD: ${{ secrets.POSTGRES_PASSWORD }}
      AUTH_EMAIL: ${{ vars.AUTH_EMAIL }}
      AUTH_PASSWORD: ${{ secrets.AUTH_PASSWORD }}
      LLM_PROVIDER: ${{ vars.LLM_PROVIDER }}
      GIGACHAT_AUTH_KEY: ${{ secrets.GIGACHAT_AUTH_KEY }}
      GIGACHAT_MODEL: ${{ vars.GIGACHAT_MODEL }}
      GIGACHAT_TEXT_MODEL: ${{ vars.GIGACHAT_TEXT_MODEL }}
      GHCR_TOKEN: ${{ secrets.GHCR_TOKEN }}
      GHCR_USER: ${{ github.actor }}
    steps:
      - uses: actions/checkout@v4

      - name: Prepare SSH
        run: |
          test -n "$DEPLOY_HOST"
          test -n "$DEPLOY_USER"
          test -n "$DEPLOY_SSH_KEY"
          : "${DEPLOY_PORT:=22}"
          mkdir -p ~/.ssh
          printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -p "$DEPLOY_PORT" -H "$DEPLOY_HOST" >> ~/.ssh/known_hosts
          echo "DEPLOY_PORT=${DEPLOY_PORT}" >> "$GITHUB_ENV"

      - name: Render deploy environment
        run: |
          : "${DEPLOY_PATH:=/opt/variantor}"
          : "${APP_PORT:=18080}"
          : "${APP_ENV:=production}"
          : "${CORS_ALLOWED_ORIGIN:=http://localhost:${APP_PORT}}"
          : "${POSTGRES_DB:=variantor}"
          : "${POSTGRES_USER:=app}"
          : "${POSTGRES_PASSWORD:=app}"
          : "${AUTH_EMAIL:=teacher@example.com}"
          : "${AUTH_PASSWORD:=secret}"
          : "${LLM_PROVIDER:=mock}"
          : "${GIGACHAT_MODEL:=GigaChat-Pro}"

          cat > .deploy.env <<EOF
          BACKEND_IMAGE=${{ needs.publish.outputs.backend_image }}:${{ github.sha }}
          FRONTEND_IMAGE=${{ needs.publish.outputs.frontend_image }}:${{ github.sha }}
          APP_PORT=${APP_PORT}
          APP_ENV=${APP_ENV}
          CORS_ALLOWED_ORIGIN=${CORS_ALLOWED_ORIGIN}
          POSTGRES_DB=${POSTGRES_DB}
          POSTGRES_USER=${POSTGRES_USER}
          POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
          AUTH_EMAIL=${AUTH_EMAIL}
          AUTH_PASSWORD=${AUTH_PASSWORD}
          LLM_PROVIDER=${LLM_PROVIDER}
          GIGACHAT_AUTH_KEY=${GIGACHAT_AUTH_KEY}
          GIGACHAT_MODEL=${GIGACHAT_MODEL}
          GIGACHAT_TEXT_MODEL=${GIGACHAT_TEXT_MODEL}
          EOF

          echo "DEPLOY_PATH=${DEPLOY_PATH}" >> "$GITHUB_ENV"

      - name: Copy compose files
        run: |
          ssh -p "$DEPLOY_PORT" -i ~/.ssh/deploy_key "$DEPLOY_USER@$DEPLOY_HOST" "mkdir -p '$DEPLOY_PATH'"
          scp -P "$DEPLOY_PORT" -i ~/.ssh/deploy_key deploy/docker-compose.prod.yml "$DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_PATH/docker-compose.yml"
          scp -P "$DEPLOY_PORT" -i ~/.ssh/deploy_key .deploy.env "$DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_PATH/.env"

      - name: Pull and restart
        run: |
          if [ -n "$GHCR_TOKEN" ]; then
            printf '%s' "$GHCR_TOKEN" | ssh -p "$DEPLOY_PORT" -i ~/.ssh/deploy_key "$DEPLOY_USER@$DEPLOY_HOST" "docker login ghcr.io -u '$GHCR_USER' --password-stdin"
          fi

          ssh -p "$DEPLOY_PORT" -i ~/.ssh/deploy_key "$DEPLOY_USER@$DEPLOY_HOST" "cd '$DEPLOY_PATH' && docker compose pull && docker compose up -d --remove-orphans && docker image prune -f"
