name: CI

on:
  pull_request:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

permissions:
  contents: read

jobs:
  backend:
    name: Backend
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_DB: variantor
          POSTGRES_USER: app
          POSTGRES_PASSWORD: app
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U app -d variantor"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 12
    defaults:
      run:
        working-directory: variantor-be
    env:
      APP_ENV: local
      DATABASE_URL: postgresql://app:app@127.0.0.1:5432/variantor
      FILE_STORAGE_DIR: /tmp/variantor-uploads
      MIGRATIONS_DIR: ./migrations
      PROMPTS_DIR: ./prompts/task_processing_pipeline_v1
      LLM_PROVIDER: mock
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: variantor-be/requirements.txt

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Compile backend
        run: python -m compileall app wsgi.py

      - name: Smoke test API
        run: |
          python - <<'PY'
          from app import create_app

          app = create_app()
          client = app.test_client()

          healthz = client.get("/healthz")
          assert healthz.status_code == 200, healthz.get_data(as_text=True)

          api_health = client.get("/api/health")
          assert api_health.status_code == 200, api_health.get_data(as_text=True)
          PY

  frontend:
    name: Frontend
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: variantor-fe
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: variantor-fe/.nvmrc
          cache: npm
          cache-dependency-path: variantor-fe/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Lint
        run: npm run lint

      - name: Build
        run: npm run build

  compose:
    name: Docker Compose
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Validate compose files
        run: |
          docker compose -f docker-compose.yml config
          BACKEND_IMAGE=variantor/backend:ci FRONTEND_IMAGE=variantor/frontend:ci docker compose -f deploy/docker-compose.prod.yml config

      - name: Build images
        run: docker compose build
