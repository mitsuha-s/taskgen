APP_ENV=local
DATABASE_URL=postgresql://app:app@127.0.0.1:55432/variantor
FILE_STORAGE_DIR=./storage/uploads
MIGRATIONS_DIR=./migrations
PROMPTS_DIR=./prompts/task_processing_pipeline_v1
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
AUTH_EMAIL=teacher@example.com
AUTH_PASSWORD=secret
PUBLIC_FILE_BASE_URL=/api/files
MAX_UPLOAD_BYTES=10485760
MAX_VARIANT_COUNT=10
ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.webp

# mock | gigachat
LLM_PROVIDER=mock
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_TEXT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_TLS=true
GIGACHAT_TIMEOUT=90
