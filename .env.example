COMPOSE_PROJECT_NAME=variantor_local
APP_PORT=18080
POSTGRES_PORT=55432

POSTGRES_DB=variantor
POSTGRES_USER=app
POSTGRES_PASSWORD=app

AUTH_EMAIL=teacher@example.com
AUTH_PASSWORD=secret
COOKIE_SECURE=false

PUBLIC_FILE_BASE_URL=/api/files
MAX_UPLOAD_BYTES=10485760
MAX_VARIANT_COUNT=10
ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.webp

# mock | gigachat
LLM_PROVIDER=mock
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_TEXT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_TLS=true
GIGACHAT_TIMEOUT=90
