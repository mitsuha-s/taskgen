APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://app:app@localhost:5432/teacher_assistant?sslmode=disable
AUTH_EMAIL=teacher@example.com
AUTH_PASSWORD=secret
FILE_STORAGE_DIR=./backend/storage/uploads
PUBLIC_FILE_BASE_URL=/api/files
FRONTEND_DIST_DIR=./frontend/dist
MIGRATIONS_DIR=./backend/migrations
PROMPTS_DIR=./prompts/task_processing_pipeline_v1
CORS_ALLOWED_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_TEXT_MODEL=GigaChat-2
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_TLS=true
GIGACHAT_TIMEOUT=90
MAX_UPLOAD_BYTES=10485760
